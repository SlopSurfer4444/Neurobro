{
  "compilerOptions": {
    "allowImportingTsExtensions": true,
    "forceConsistentCasingInFileNames": true,
    "module": "NodeNext",
    "moduleResolution": "NodeNext",
    "noEmit": true,
    "strict": true,
    "target": "ES2024",
    "types": ["node"],
    "typeRoots": ["../telegram-gateway/node_modules/@types"]
  },
  "include": ["src/**/*.ts", "test/**/*.ts", "bench/**/*.ts"]
}
